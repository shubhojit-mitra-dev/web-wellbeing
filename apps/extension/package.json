    "test": "vitest run"
  },
  "dependencies": {
    "@web-wellbeing/shared": "workspace:*",
    "@web-wellbeing/supabase": "workspace:*",
    "@web-wellbeing/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "4.3.4",
    "@web-wellbeing/eslint-config": "workspace:*",
    "@web-wellbeing/tsconfig": "workspace:*",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.7",
    "vite": "^6.1.0",
